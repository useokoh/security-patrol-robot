<?xml version="1.0"?>
<!--
  피지컬AI ROS2 강의에서 만든 ESP32 로봇 (robot.urdf.xacro) 기반.
  링크/조인트 이름과 치수는 원본 그대로이고, Gazebo 에 필요한 collision/inertial 만 추가했다.
  use_sim:=true 일 때만 Gazebo 플러그인(바퀴 구동, 라이다)을 포함한다. 실제 로봇은 use_sim:=false.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

        <xacro:arg name="use_sim" default="false"/>

        <!-- 관성 계산 매크로 -->
        <xacro:macro name="box_inertial" params="m x y z">
                <inertial>
                        <mass value="${m}"/>
                        <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
                                 iyy="${m*(x*x+z*z)/12}" iyz="0"
                                 izz="${m*(x*x+y*y)/12}"/>
                </inertial>
        </xacro:macro>

        <xacro:macro name="cylinder_inertial" params="m r h">
                <inertial>
                        <mass value="${m}"/>
                        <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
                                 iyy="${m*(3*r*r+h*h)/12}" iyz="0"
                                 izz="${m*r*r/2}"/>
                </inertial>
        </xacro:macro>

        <!-- 바퀴 매크로: side_sign = 1(왼쪽) / -1(오른쪽), x = 앞뒤 위치 -->
        <xacro:property name="wheel_radius" value="0.0337"/>
        <xacro:property name="wheel_width" value="0.0265"/>

        <xacro:macro name="wheel" params="name x side_sign">
                <joint name="${name}_wheel_joint" type="continuous">
                        <parent link="chassis"/>
                        <child link="${name}_wheel"/>
                        <origin xyz="${x} ${side_sign*0.0725} -0.0047" rpy="${-side_sign*pi/2} 0 0"/>
                        <axis xyz="0 0 ${side_sign}"/>
                </joint>

                <link name="${name}_wheel">
                        <visual>
                                <geometry>
                                        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                                </geometry>
                                <material name="white"/>
                        </visual>
                        <collision>
                                <geometry>
                                        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                                </geometry>
                        </collision>
                        <xacro:cylinder_inertial m="0.03" r="${wheel_radius}" h="${wheel_width}"/>
                </link>
        </xacro:macro>

        <material name="white">
                <color rgba="1 1 1 0.5"/>
        </material>

        <link name="base_link"></link>

        <joint name="chassis_joint" type="fixed">
                <parent link="base_link"/>
                <child link="chassis"/>
                <origin xyz="0 0 0.0384" rpy="0 0 0"/>
        </joint>

        <link name="chassis">
                <visual>
                        <geometry>
                                <box size="0.2 0.112 0.0016"/>
                        </geometry>
                        <material name="white"/>
                </visual>
                <!-- PCB 위 부품(배터리, 모터 드라이버 등) 높이를 감안해 충돌 상자는 두껍게 잡는다 -->
                <collision>
                        <origin xyz="0 0 0.01" rpy="0 0 0"/>
                        <geometry>
                                <box size="0.2 0.112 0.02"/>
                        </geometry>
                </collision>
                <xacro:box_inertial m="0.5" x="0.2" y="0.112" z="0.02"/>
        </link>

        <xacro:wheel name="front_left" x="0.0814" side_sign="1"/>
        <xacro:wheel name="rear_left" x="-0.0814" side_sign="1"/>
        <xacro:wheel name="front_right" x="0.0814" side_sign="-1"/>
        <xacro:wheel name="rear_right" x="-0.0814" side_sign="-1"/>

        <joint name="laser_joint" type="fixed">
                <parent link="chassis"/>
                <child link="laser_frame"/>
                <origin xyz="0.0625 0 0.053" rpy="0 0 0"/>
        </joint>

        <link name="laser_frame">
                <visual>
                        <geometry>
                                <cylinder radius="0.0299" length="0.026"/>
                        </geometry>
                        <material name="white"/>
                </visual>
                <xacro:cylinder_inertial m="0.05" r="0.0299" h="0.026"/>
        </link>

        <joint name="controller_joint" type="fixed">
                <parent link="chassis"/>
                <child link="controller_frame"/>
                <origin xyz="-0.0657 0 0.0071" rpy="0 0 0"/>
        </joint>

        <link name="controller_frame">
                <visual>
                        <geometry>
                                <box size="0.06858 0.05334 0.0126"/>
                        </geometry>
                        <material name="white"/>
                </visual>
                <xacro:box_inertial m="0.02" x="0.06858" y="0.05334" z="0.0126"/>
        </link>

        <joint name="camera_joint" type="fixed">
                <parent link="chassis"/>
                <child link="camera_link"/>
                <origin xyz="0.1 0 0.0208" rpy="0 0 0"/>
        </joint>

        <link name="camera_link">
                <visual>
                        <geometry>
                                <box size="0.007 0.034 0.040"/>
                        </geometry>
                        <material name="white"/>
                </visual>
                <xacro:box_inertial m="0.01" x="0.007" y="0.034" z="0.040"/>
        </link>

        <joint name="camera_optical_joint" type="fixed">
                <parent link="camera_link"/>
                <child link="camera_link_optical"/>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
        </joint>

        <link name="camera_link_optical"></link>

        <joint name="base_footprint_joint" type="fixed">
                <parent link="base_link"/>
                <child link="base_footprint"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

        <link name="base_footprint"></link>

        <xacro:if value="$(arg use_sim)">
                <xacro:include filename="$(find security_patrol)/urdf/patrol_bot.gazebo.xacro"/>
        </xacro:if>
</robot>
