<?xml version="1.0"?>
<!-- 사람 후보 오판 시험용 상자: 30 x 30 x 50 cm. 라이다에는 폭 30 cm 한 덩어리로 보여야 하고
     '사람 후보'로 표시되면 안 된다. -->
<sdf version="1.8">
  <model name="test_box">
    <static>true</static>
    <link name="box">
      <collision name="collision">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry><box><size>0.3 0.3 0.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry><box><size>0.3 0.3 0.5</size></box></geometry>
        <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
